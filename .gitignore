# Secrets — never commit (DESIGN §4.8/§12)
.env

# Step-0 spike (throwaway, per DESIGN §4.2/§9.4)
spike.py
spike_survey_log.csv
.venv-spike/

# Go build output
/ingester/ingester
/ingester/ingester.exe
/readapi/readapi
/readapi/readapi.exe

# OS / editor cruft
.DS_Store
Thumbs.db

# Terraform (Layer A) — state can contain secrets; tfvars holds the SSH key.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Cloudflare Tunnel credentials (DESIGN §4.8) — the tunnel's private key.
cloudflared/*.json
!cloudflared/config.example.yml

# Make scratch dir (one-key env files used to build secrets)
.make-tmp/

# Local learning notes and diagrams - not part of the deliverable.
learn/

# wrangler local state (Cloudflare Pages tooling)
.wrangler/

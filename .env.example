# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# SPTrans Olho Vivo API token — register at
# https://www.sptrans.com.br/desenvolvedores/  (unquoted value, no surrounding quotes)
SPTRANS_TOKEN=

# Local TimescaleDB credentials. docker-compose supplies these same defaults if
# omitted; this is a throwaway LOCAL database, not a real secret.
POSTGRES_USER=transit
POSTGRES_PASSWORD=transit_local
POSTGRES_DB=transit

# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# SPTrans Olho Vivo API token — register at
# https://www.sptrans.com.br/desenvolvedores/  (unquoted value, no surrounding quotes)
SPTRANS_TOKEN=

# Local TimescaleDB credentials. docker-compose supplies these same defaults if
# omitted; this is a throwaway LOCAL database, not a real secret.
POSTGRES_USER=transit
POSTGRES_PASSWORD=transit_local
POSTGRES_DB=transit

# --- Deploy (DESIGN §9.4 step 6) --------------------------------------------
# Production database password. Unlike the local one above this is a real secret:
# generate it once and keep it, since recreating the secret with a different value
# would leave the running Postgres with the old password.
#   openssl rand -base64 24
POSTGRES_PASSWORD_PROD=

# GitHub Container Registry pull credentials. The images are in a private repo, so
# the cluster needs a credential to pull them. Personal access token (classic) with
# read:packages; write:packages as well if you push from this machine.
GHCR_USER=
GHCR_TOKEN=
